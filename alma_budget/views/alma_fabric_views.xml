<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================
         VISTAS: TEJIDOS (alma.fabric)
    ================================================================ -->
    <record id="view_alma_fabric_tree" model="ir.ui.view">
        <field name="name">alma.fabric.tree</field>
        <field name="model">alma.fabric</field>
        <field name="arch" type="xml">
            <tree>
                <field name="ref1" string="REF 1" optional="show"/>
                <field name="ref2" string="REF 2" optional="show"/>
                <field name="ref_combined" string="REF Combinada"/>
                <field name="name" string="Tejido"/>
                <field name="shrinkage_width" string="Encog. Ancho %" digits="[6,4]" optional="show"/>
                <field name="shrinkage_length" string="Encog. Largo %" digits="[6,4]" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_alma_fabric_form" model="ir.ui.view">
        <field name="name">alma.fabric.form</field>
        <field name="model">alma.fabric</field>
        <field name="arch" type="xml">
            <form string="Tejido">
                <sheet>
                    <group>
                        <group string="Identificación">
                            <field name="name"/>
                            <field name="ref1"/>
                            <field name="ref2"/>
                            <field name="ref_combined" readonly="1"/>
                        </group>
                        <group string="Encogimientos">
                            <field name="shrinkage_width" string="Encogimiento Ancho (%)" widget="percentage"/>
                            <field name="shrinkage_length" string="Encogimiento Largo (%)" widget="percentage"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Colores disponibles">
                            <field name="color_ids">
                                <tree editable="bottom">
                                    <field name="color_code" string="Cód."/>
                                    <field name="color_name" string="Color"/>
                                    <field name="ref3" string="REF 3" readonly="1"/>
                                    <field name="cost" string="Coste €/m" digits="[10,4]"/>
                                    <field name="width" string="Ancho (m)" digits="[6,3]"/>
                                    <field name="composition" string="Composición" optional="show"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_alma_fabric" model="ir.actions.act_window">
        <field name="name">Tejidos</field>
        <field name="res_model">alma.fabric</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ================================================================
         VISTAS: EMPALMES (alma.empalme)
    ================================================================ -->
    <record id="view_alma_empalme_tree" model="ir.ui.view">
        <field name="name">alma.empalme.tree</field>
        <field name="model">alma.empalme</field>
        <field name="arch" type="xml">
            <tree editable="top">
                <field name="fabric_width_cm" string="Ancho Tejido (cm)"/>
                <field name="mantel_width_cm" string="Ancho Mantel (cm)"/>
                <field name="ref_empalme" string="REF" readonly="1"/>
                <field name="empalme_length_cm" string="Largo Empalme (cm)"/>
                <field name="empalme_width_cm" string="Ancho Empalme (cm)" readonly="1"/>
                <field name="pieces_per_width" string="Piezas/Ancho" readonly="1"/>
            </tree>
        </field>
    </record>

    <record id="action_alma_empalme" model="ir.actions.act_window">
        <field name="name">Tabla de Empalmes</field>
        <field name="res_model">alma.empalme</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ================================================================
         VISTAS: TIPOS DE ARTÍCULO (alma.article.type)
    ================================================================ -->
    <record id="action_alma_article_type" model="ir.actions.act_window">
        <field name="name">Tipos de Artículo</field>
        <field name="res_model">alma.article.type</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
